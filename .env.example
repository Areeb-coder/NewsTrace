# Copy this file to .env and fill in your own credentials.
# Never commit .env or paste real credentials into this template.

# Optional: enable Supabase persistence
SUPABASE_URL=
SUPABASE_KEY=

# Optional: enable Google / SerpAPI enrichment
SERP_API_KEY=

# Optional: FastAPI discovery job store and concurrency
NEWSTRACE_DB_PATH=data/newstrace.sqlite3
NEWSTRACE_MAX_ACTIVE_JOBS=1

# Optional: only needed when the frontend runs on a different local origin
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEWSTRACE_DISCOVERY_RATE_LIMIT=5
NEWSTRACE_DISCOVERY_RATE_WINDOW=600
