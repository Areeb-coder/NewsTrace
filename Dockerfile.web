# Build the static Next.js frontend.
FROM node:26-bookworm-slim AS frontend

ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /frontend

COPY frontend/package.json ./
RUN npm install --no-audit --no-fund

COPY frontend/ ./
RUN npm run typecheck && npm run build

# Keep the existing Python/Playwright runtime for article extraction.
FROM mcr.microsoft.com/playwright/python:v1.64.1-noble AS web

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements.txt ./
RUN python -m pip install --upgrade pip && \
    python -m pip install -r requirements.txt

COPY . .
COPY --from=frontend /frontend/out ./frontend/out

EXPOSE 8000

# One API process owns the in-process job scheduler. Do not increase workers
# unless the job store/queue is moved to a shared external service.
CMD ["sh", "-c", "uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --proxy-headers"]
