# Server-only Supabase project URL and service-role key.
# Required in production because Render's free filesystem is ephemeral.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional legacy anon key for projects using explicit RLS policies.
# The backend prefers SUPABASE_SERVICE_ROLE_KEY when configured.
SUPABASE_KEY=

# Optional public-profile enrichment.
SERP_API_KEY=

# Discovery job store: SQLite locally; Supabase in production.
NEWSTRACE_DB_PATH=data/newstrace.sqlite3
NEWSTRACE_REQUIRE_DURABLE_STORE=false
NEWSTRACE_MAX_ACTIVE_JOBS=1

# Used only when the frontend runs on a different local origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEWSTRACE_DISCOVERY_RATE_LIMIT=5
NEWSTRACE_DISCOVERY_RATE_WINDOW=600
